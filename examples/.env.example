# Copy to .env and edit. Used by docker-compose.postgres.yml.

# Database password for the bundled PostgreSQL (required).
POSTGRES_PASSWORD=change-me

# --- Optional rpodder settings (uncomment in the compose file to use) ---
# Public URL for OAuth/SSO callbacks and email links.
# RPODDER_BASE_URL=https://podcasts.example.com

# Registration mode: open | closed | invite
# RPODDER_REGISTRATION=open

# OAuth2 / OIDC single sign-on (e.g. Authentik, Keycloak).
# RPODDER_OAUTH_ISSUER_URL=https://auth.example.com/application/o/rpodder/
# RPODDER_OAUTH_CLIENT_ID=
# RPODDER_OAUTH_CLIENT_SECRET=
# RPODDER_OAUTH_ADMIN_GROUP=admins
